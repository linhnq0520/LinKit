<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <NoWarn>$(NoWarn);CS9270</NoWarn>
    <PackageId>LinKit.Messaging.RabbitMQ</PackageId>
    <Version>1.5.0</Version>
    <Description>RabbitMQ producer and consumer integration for LinKit messaging abstractions.</Description>
    <PackageTags>linkit;messaging;rabbitmq;cqrs;aot</PackageTags>
    <PackageReleaseNotes>v1.5.0: Native AOT and trimming analyzers are now enforced on the package. Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinKit.Messaging.Tests" />
  </ItemGroup>
</Project>
