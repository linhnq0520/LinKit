<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LinKit.Grpc</PackageId>
    <Version>2.2.0</Version>
    <Description>Source-generated gRPC server and client adapters for LinKit CQRS requests.</Description>
    <PackageTags>linkit;grpc;source-generator;cqrs;mediator;aot</PackageTags>
    <PackageReleaseNotes>v2.2.0: legacy Grpc.Core dependency replaced by Grpc.Core.Api and Grpc.Net.Client so the package is AOT compatible; reflection-based client activation removed; channel cache is bounded and disposed. Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
    <ProjectReference
      Include="..\LinKit.Grpc.Generator\LinKit.Grpc.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\LinKit.Grpc.Generator\bin\$(Configuration)\netstandard2.0\LinKit.Grpc.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>
