<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LinKit.Core\LinKit.Core.csproj" />
    <ProjectReference Include="..\..\LinKit.Caching\LinKit.Caching.csproj" />
    <ProjectReference Include="..\..\LinKit.Resilience\LinKit.Resilience.csproj" />
    <ProjectReference Include="..\..\LinKit.Data\LinKit.Data.csproj" />
    <ProjectReference Include="..\..\LinKit.Tenancy\LinKit.Tenancy.csproj" />
    <ProjectReference Include="..\..\LinKit.Outbox\LinKit.Outbox.csproj" />
    <ProjectReference Include="..\..\LinKit.Outbox.Data\LinKit.Outbox.Data.csproj" />
    <ProjectReference Include="..\..\LinKit.Sagas\LinKit.Sagas.csproj" />
    <ProjectReference Include="..\..\LinKit.Json\src\LinKit.Json\LinKit.Json.csproj" />
    <ProjectReference Include="..\..\LinKit.Generator\LinKit.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\LinKit.Data.Generator\LinKit.Data.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>
</Project>
