<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LinKit.Tenancy</PackageId>
    <Version>2.0.0</Version>
    <Description>Async-flow tenant context with explicit scopes and message-header propagation primitives for LinKit.</Description>
    <PackageTags>linkit;multitenancy;saas;aot</PackageTags>
    <PackageReleaseNotes>v2.0.0: the ambient tenant is no longer auto-created. TryGet/Require are separate and ITenantScope guarantees a deterministic reset. Tenant id is propagated through outbox message headers. Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>
</Project>
