<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LinKit.Data</PackageId>
    <Version>2.4.0</Version>
    <Description>Source-generated ADO.NET data access and additive schema synchronization for LinKit; every runtime path is Native AOT and trim analysed.</Description>
    <PackageTags>linkit;data;repository;schema-synchronization;ado-net;aot;cqrs</PackageTags>
    <PackageReleaseNotes>v2.4.0: Set-based InsertRange/UpdateRange/DeleteRange (multi-row VALUES and chunked IN) instead of one round-trip per row, typed DbDataReader accessors in generated mappers, inherited-property support for [DataRecord], configurable command timeout/isolation, and an opt-in concurrent DataSession mode. Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinKit.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
    <ProjectReference
      Include="..\LinKit.Data.Generator\LinKit.Data.Generator.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\LinKit.Data.Generator\bin\$(Configuration)\netstandard2.0\LinKit.Data.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>
