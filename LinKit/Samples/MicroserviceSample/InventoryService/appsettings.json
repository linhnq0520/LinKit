{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Messaging": {
    "Broker": "RabbitMQ"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "PrefetchCount": 50,
    "ChannelPoolSize": 64
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "inventory-service-group"
  }
}
