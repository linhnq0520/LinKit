<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LinKit.Core\LinKit.Core.csproj" />
    <ProjectReference Include="..\..\LinKit.Caching\LinKit.Caching.csproj" />
    <ProjectReference Include="..\..\LinKit.Resilience\LinKit.Resilience.csproj" />
    <ProjectReference Include="..\..\LinKit.Data\LinKit.Data.csproj" />
    <ProjectReference Include="..\..\LinKit.Tenancy\LinKit.Tenancy.csproj" />
    <ProjectReference Include="..\..\LinKit.Outbox\LinKit.Outbox.csproj" />
    <ProjectReference Include="..\..\LinKit.Outbox.Data\LinKit.Outbox.Data.csproj" />
    <ProjectReference Include="..\..\LinKit.Sagas\LinKit.Sagas.csproj" />
    <ProjectReference Include="..\..\LinKit.Json\src\LinKit.Json\LinKit.Json.csproj" />
    <!-- Analyzers do not flow through ProjectReference, so the generators are declared explicitly. -->
    <ProjectReference
      Include="..\..\LinKit.Generator\LinKit.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\..\LinKit.Data.Generator\LinKit.Data.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>
</Project>
