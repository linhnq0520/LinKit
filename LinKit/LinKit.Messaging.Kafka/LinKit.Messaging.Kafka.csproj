<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <NoWarn>$(NoWarn);CS9270</NoWarn>
    <PackageId>LinKit.Messaging.Kafka</PackageId>
    <Version>1.5.1</Version>
    <Description>Apache Kafka producer and consumer integration for LinKit messaging abstractions.</Description>
    <PackageTags>linkit;messaging;kafka;cqrs;aot</PackageTags>
    <PackageReleaseNotes>v1.5.1: documentation and packaging patch - every public member now carries XML documentation (CS1591 is enforced as a build error) and the README was reviewed for accuracy. Previous release: v1.5.0 - KafkaOptions are validated through IValidateOptions - an empty BootstrapServers or GroupId, a non-positive BatchSize or a negative attempt/linger setting fails at startup instead of degrading at runtime. Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinKit.Messaging.Tests" />
  </ItemGroup>
</Project>
