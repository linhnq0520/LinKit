{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Broker": "RabbitMQ"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "PrefetchCount": 50,
    "ChannelPoolSize": 64
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "LingerMs": 5,
    "BatchSize": 65536
  },
  "GrpcClients": {
    "InventoryServiceClient": "http://localhost:5005"
  }
}
