<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LinKit.Resilience</PackageId>
    <Version>1.3.0</Version>
    <Description>Retry, timeout, and circuit-breaker execution primitives for LinKit applications.</Description>
    <PackageTags>linkit;resilience;circuit-breaker;retry;aot</PackageTags>
    <PackageReleaseNotes>v1.3.0: Circuit breaker half-open state now admits exactly one probe, and the retry delay jitter is documented and bounded. Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
