<Project Sdk="Microsoft.NET.Sdk">
  <!-- Native AOT smoke test: publish this project with `dotnet publish -c Release -r <rid>` and run the executable.
       PublishAot is set only here, never on the netstandard2.0 generators (avoids NETSDK1207). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\LinKit.Core\LinKit.Core.csproj" />
    <ProjectReference Include="..\..\LinKit.Caching\LinKit.Caching.csproj" />
    <ProjectReference Include="..\..\LinKit.Resilience\LinKit.Resilience.csproj" />
    <ProjectReference Include="..\..\LinKit.Outbox\LinKit.Outbox.csproj" />
    <ProjectReference Include="..\..\LinKit.Outbox.Data\LinKit.Outbox.Data.csproj" />
    <ProjectReference Include="..\..\LinKit.Data\LinKit.Data.csproj" />
    <!-- Analyzers do not flow through ProjectReference, so the generators are declared explicitly. -->
    <ProjectReference
      Include="..\..\LinKit.Generator\LinKit.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\..\LinKit.Data.Generator\LinKit.Data.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
