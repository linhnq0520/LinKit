<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="Protos\inventory.proto" GrpcServices="Both" />
    <PackageReference Include="Grpc.AspNetCore" />
    <ProjectReference Include="..\..\..\LinKit.Core\LinKit.Core.csproj" />
    <ProjectReference Include="..\..\..\LinKit.Grpc\LinKit.Grpc.csproj" />
    <!-- Analyzers do not flow through ProjectReference, so the generators are declared explicitly. -->
    <ProjectReference
      Include="..\..\..\LinKit.Generator\LinKit.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference
      Include="..\..\..\LinKit.Grpc.Generator\LinKit.Grpc.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
</Project>
