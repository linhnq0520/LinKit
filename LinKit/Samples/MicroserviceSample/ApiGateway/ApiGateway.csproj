<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\LinKit.Core\LinKit.Core.csproj" />
    <!-- Analyzers do not flow through ProjectReference, so the generator is declared explicitly. -->
    <ProjectReference
      Include="..\..\..\LinKit.Generator\LinKit.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference Include="..\..\..\LinKit.Grpc\LinKit.Grpc.csproj" />
    <ProjectReference
      Include="..\..\..\LinKit.Grpc.Generator\LinKit.Grpc.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
    <ProjectReference Include="..\SharedContracts\SharedContracts.csproj" />
  </ItemGroup>
</Project>
