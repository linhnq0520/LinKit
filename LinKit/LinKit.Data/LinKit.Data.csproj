<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LinKit.Data</PackageId>
    <Version>2.6.0</Version>
    <Description>Source-generated ADO.NET data access and additive schema synchronization for LinKit; every runtime path is Native AOT and trim analysed.</Description>
    <PackageTags>linkit;data;repository;schema-synchronization;ado-net;aot;cqrs</PackageTags>
    <PackageReleaseNotes>v2.6.0: richer expression surface and faster plans - column-to-column comparisons (NotEqual/GreaterThan/LessThan and their OrEqual variants), Sql.Lower/Upper/Trim/Length/Coalesce/Count/CountDistinct with per-provider function names, tenant and soft-delete predicates pushed into WHERE and into join ON clauses instead of wrapping tables in derived subqueries, Repository.FindManyAsync for chunked IN loads instead of N+1 loops, plus AnyAsync/CountAsync/ListAsync predicate overloads, StreamAsync and DeleteAsync(entity). Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LinKit.Messaging.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
    <ProjectReference
      Include="..\LinKit.Data.Generator\LinKit.Data.Generator.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\LinKit.Data.Generator\bin\$(Configuration)\netstandard2.0\LinKit.Data.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
</Project>
