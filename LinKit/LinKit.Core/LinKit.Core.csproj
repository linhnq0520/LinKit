<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LinKit.Core</PackageId>
    <Version>3.4.0</Version>
    <Description>A modular .NET toolkit with source-generated CQRS, endpoints, messaging, mapping, and dependency-injection helpers.</Description>
    <PackageTags>source-generator;performance;aot;cqrs;mediator;di;background;job</PackageTags>
    <PackageReleaseNotes>v3.4.0: Native AOT and trimming analyzers are now enforced on the package itself. Microsoft.Extensions.* dependencies are published as normal transitive dependencies (previously PrivateAssets=all, which broke consumers). Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\LinKit.Generator\LinKit.Generator.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <ItemGroup>
    <!-- Public API surface exposes IServiceCollection/IHostedService/ILogger, so these must stay transitive. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="..\LinKit.Generator\bin\$(Configuration)\netstandard2.0\LinKit.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Json\" />
  </ItemGroup>
</Project>
