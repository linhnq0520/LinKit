<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LinKit.Caching</PackageId>
    <Version>1.4.0</Version>
    <Description>Two-level (memory + RESP2 Redis) caching for LinKit with expiration, bounded LRU capacity, and single-flight creation.</Description>
    <PackageTags>linkit;caching;hybrid-cache;redis;resp2;aot</PackageTags>
    <PackageReleaseNotes>v1.4.0: Redis TLS, ACL username authentication and key prefixes, plus EXISTS/TTL/EXPIRE/INCR/MGET/MSET and prefix invalidation. Single-flight no longer blocks a pool thread while holding a lock. Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
