<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LinKit.Sagas</PackageId>
    <Version>2.0.0</Version>
    <Description>Saga step coordination and compensation abstractions with a replaceable, version-guarded state repository.</Description>
    <PackageTags>linkit;sagas;orchestration;microservices;aot</PackageTags>
    <PackageReleaseNotes>v2.0.0: ISagaRepository gains optimistic concurrency (Version), idempotent compensation tracking and GetStuckAsync. In-memory repository is rejected in Production unless explicitly allowed. Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
