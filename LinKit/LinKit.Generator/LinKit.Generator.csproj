<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Attributes are linked into the generator so semantic analysis does not depend on LinKit.Core. -->
    <Compile Include="..\LinKit.Core\Abstractions\Lifetime.cs" Link="Linked\Lifetime.cs" />
    <Compile
      Include="..\LinKit.Core\Abstractions\RegisterServiceAttribute.cs"
      Link="Linked\RegisterServiceAttribute.cs"
    />
    <Compile Include="..\LinKit.Core\Cqrs\CqrsAttributes.cs" Link="Linked\CqrsAttributes.cs" />
    <Compile
      Include="..\LinKit.Core\Endpoints\EndpointAttribute.cs"
      Link="Linked\EndpointAttribute.cs"
    />
    <Compile Include="..\LinKit.Core\Endpoints\FromAttribute.cs" Link="Linked\FromAttribute.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
</Project>
