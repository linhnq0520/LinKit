<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <PackageId>LinKit.Caching</PackageId>
    <Version>1.5.1</Version>
    <Description>Two-level (memory + RESP2 Redis) caching for LinKit with expiration, bounded LRU capacity, and single-flight creation.</Description>
    <PackageTags>linkit;caching;hybrid-cache;redis;resp2;aot</PackageTags>
    <PackageReleaseNotes>v1.5.1: documentation and packaging patch - every public member now carries XML documentation (CS1591 is enforced as a build error) and the README was reviewed for accuracy. Previous release: v1.5.0 - Redis options are validated at registration - a bad host, port, database or timeout throws InvalidOperationException immediately instead of turning every read into a silent miss. The [CacheAside]/[InvalidateCache] metadata attributes were removed from LinKit.Core 4.0.0; call ICacheProvider.GetOrCreateAsync/RemoveAsync explicitly. Full documentation &amp; release notes: https://quoclinh.id.vn/docs/linkit</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LinKit.Core\LinKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
